// Cloudflare Worker serving the built SPA at https://astral.syb.lol.
// Deploy: npm run deploy (builds the PWA into dist/pwa first)
{
  "name": "astral-syb-lol",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "dist/pwa",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "astral.syb.lol", "custom_domain": true }
  ]
}

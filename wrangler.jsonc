// Cloudflare Worker serving https://astral.syb.lol: the built PWA as static
// assets, plus a small script for /api/* (link previews, worker/index.js).
// Deploy: npm run deploy (builds the PWA into dist/pwa first)
{
  "name": "astral-syb-lol",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "dist/pwa",
    "binding": "ASSETS",
    // no fallback here: a request no file matches goes to the script, which
    // serves index.html for app pages and a real 404 for missing files
    "not_found_handling": "none",
    // everything else is served from assets without running the script
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "astral.syb.lol", "custom_domain": true }
  ]
}
